# Copy this file to .env.local and fill values from Roboflow's Deploy Workflow
# snippet. Never commit .env.local or paste its contents into logs/issues.
ROBOFLOW_API_KEY=
# Passed to the hosted Qwen workflow as its model_api_key parameter.
OPENROUTER_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_WORKFLOW_ID=
ROBOFLOW_API_URL=https://serverless.roboflow.com
