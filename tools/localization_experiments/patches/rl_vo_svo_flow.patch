+      pairs.block<1, 2>(row, 1) =
+          flow_previous_frames_->at(0)->px_vec_.col(previous_index).transpose();
+      pairs.block<1, 2>(row, 3) =
+          current_frames->at(0)->px_vec_.col(current_index).transpose();
+    }
